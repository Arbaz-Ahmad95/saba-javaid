{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/hero.jpeg",
      "destination": "/client/hero.jpeg"
    },
    {
      "source": "/fitx.png",
      "destination": "/client/fitx.png"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
